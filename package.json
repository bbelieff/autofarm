{
  "name": "autofarm",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @autofarm/web dev",
    "dev:worker": "pnpm --filter @autofarm/worker dev",
    "db:start": "pnpm --filter @autofarm/db db:start",
    "db:migrate": "pnpm --filter @autofarm/db db:migrate",
    "db:generate": "pnpm --filter @autofarm/db db:generate",
    "db:seed": "pnpm --filter @autofarm/db db:seed",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.2"
  },
  "type": "module"
}
