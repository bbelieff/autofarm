# 로컬: pnpm db:start 가 이 주소로 embedded-postgres 를 띄웁니다
DATABASE_URL=postgres://autofarm:autofarm@127.0.0.1:54329/autofarm
# 비밀 금고 마스터 키(32바이트 base64). 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VAULT_MASTER_KEY=
# 세션 쿠키 서명용
SESSION_SECRET=
# 파일 저장 위치
STORAGE_DIR=./storage
